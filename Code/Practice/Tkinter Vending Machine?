def coins(paid, price):
    moneyLeft = int(round((paid - price) * 100))
    coinAmount = [3, 1, 5, 4, 2, 7]
    coinsUsed = [0, 0, 0, 0, 0, 0] #defines number of coins used within a list
    coinsAvailable = {200: 3, 100: 1, 50: 5, 20: 4, 10: 2, 5: 7} #dictionary?
    
    while True:
        if paid < price:
            print("Insufficient payment.")
            break
        elif moneyLeft >= 200 and coinAmount[0] > 0:
            moneyLeft -= 200
            coinsUsed[0] = coinsUsed[0] + 1
            coinAmount[0] = coinAmount[0] - 1
        elif moneyLeft >= 100 and coinAmount[1] > 0:
            moneyLeft -= 100
            coinsUsed[1] = coinsUsed[1] + 1
            coinAmount[1] = coinAmount[1] - 1
        elif moneyLeft >= 50 and coinAmount[2] > 0:
            moneyLeft -= 50
            coinsUsed[2] = coinsUsed[2] + 1
            coinAmount[2] = coinAmount[2] - 1
        elif moneyLeft >= 20 and coinAmount[3] > 0:
            moneyLeft -= 20
            coinsUsed[3] = coinsUsed[3] + 1
            coinAmount[3] = coinAmount[3] - 1
        elif moneyLeft >= 10 and coinAmount[4] > 0:
            moneyLeft -= 10
            coinsUsed[4] = coinsUsed[4] + 1
            coinAmount[4] = coinAmount[4] - 1
        elif moneyLeft >= 5 and coinAmount[5] > 0:
            moneyLeft -= 5
            coinsUsed[5] = coinsUsed[5] + 1
            coinAmount[5] = coinAmount[5] - 1
        else:
            remainder = moneyLeft
            break
    print("Your change is $"+ str((paid - price)) + " which will be paid by: \n$2 x " + str(coinsUsed[0]) + "\n$1 x " + str(coinsUsed[1]) + "\n$0.50 x " + str(coinsUsed[2]) +
          "\n$0.20 x " + str(coinsUsed[3]) + "\n$0.10 x " + str(coinsUsed[4]) + "\n$0.05 x " + str(coinsUsed[5]))
    if remainder != 0:
        print("Because of the limited number of coins available, you are still owed $" + str(remainder/100))

