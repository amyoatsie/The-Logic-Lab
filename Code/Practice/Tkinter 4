import tkinter as tk #allows us to reference tkinter as tk
from tkinter import ttk, messagebox #imports the 'tkk' class, which is a blueprint

root = tk.Tk() #calls the 'tk' method, and gets the return value defined as root
root.title("Add Student (v1)") #an attribute of 'root' is the title
root.geometry("500x250") #another parameter is geometry
root.columnconfigure(0, weight=1)
root.rowconfigure(0, weight=1)

style = ttk.Style() #creates a style object - explore themes in tkinter
style.configure('#pink.TFrame', background="#ffd0ef") #configured the styled object

frame = ttk.Frame(root, padding = 12, style='#pink.TFrame') #a frame is a container, the padding is the border, it goes in root which is like a cell
frame.grid(row=0, column=0, sticky="NSEW") #grid gives you more control then 'pac', NSEW is the directions the size should stick to
frame.columnconfigure(1, weight=1)

student_var = tk.StringVar() #name_var is a type of snake case
ttk.Label(frame, text="Student ID: ").grid(row=0, column=0, sticky="w", pady=6) #label is a class
id_entry = ttk.Entry(frame, textvariable=student_var); id_entry.grid(row=0, column=1, sticky="EW", pady=6)

name_var = tk.StringVar() #name_var is a type of snake case
ttk.Label(frame, text="Name: ").grid(row=1, column=0, sticky="w", pady=6) #label is a class
ttk.Entry(frame, textvariable=name_var).grid(row=1, column=1, sticky="EW", pady=6)

bus_var = tk.BooleanVar(value=True)  # stores True/False
ttk.Label(frame, text="Bus Traveller:").grid(row=2, column=0, sticky="w", pady=6)
ttk.Checkbutton(frame, text="Yes", variable=bus_var).grid(row=2, column=1, sticky="w", pady=6, padx=6) #creates a checkbutton as input, rather than entry

def save(_event=None):
    if not student_var.get().strip().isdigit(): #validates the variable not object
        messagebox.showerror("Invalid", "Student ID must be a whole number.")
        return
    if not name_var.get().strip():
        messagebox.showerror("Invalid", "Name is required.")
        return
    if bus_var.get(): # Use .get()
        bus_message = "Takes the Bus"
    else:
        bus_message = "Does Not Take the Bus"
        
    messagebox.showinfo("Saved", f"Saved: {student_var.get()} - {name_var.get().strip()} - Travel: {bus_message}")


    #reset form
    student_var.set("")
    name_var.set("")
    id_entry.focus_set()

ttk.Button(frame, text='Save', command=save).grid(row=3, column=0, columnspan=2, sticky="EW", pady=6, padx=6)
root.bind("<Return>", save)

root.mainloop()