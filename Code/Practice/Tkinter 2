import tkinter as tk #allows us to reference tkinter as tk
from tkinter import ttk, messagebox #imports the 'tkk' class, which is a blueprint

root = tk.Tk() #calls the 'tk' method, and gets the return value defined as root
root.title("Hello World") #an attribute of 'root' is the title
root.geometry("700x150") #another parameter is geometry
root.columnconfigure(0, weight=1)
root.rowconfigure(0, weight=1)

style = ttk.Style() #creates a style object - explore themes in tkinter
style.configure('Red.TFrame', background='red') #configured the styled object

frame = ttk.Frame(root, padding = 12, style='Red.TFrame') #a frame is a container, the padding is the border, it goes in root which is like a cell
frame.grid(row=0, column=0, sticky="NSEW") #grid gives you more control then 'pac', NSEW is the directions the size should stick to
frame.columnconfigure(1, weight=1)

name_var = tk.StringVar() #name_var is a type of snake case
ttk.Label(frame, text="Name: ").grid(row=0, column=0, sticky="w", pady=6)
ttk.Entry(frame, textvariable=name_var).grid(row=0, column=1, sticky="EW", pady=6)

def greet():
    messagebox.showinfo("Hello", f"Hi {name_var.get().strip()}")

ttk.Button(frame, text='Greet', command=greet).grid(row=1, column=0, columnspan=2, sticky="EW", pady=6, padx=6)

root.mainloop() #IMPORTANT

