import tkinter as tk
from tkinter import ttk
from tkinter import messagebox
import datetime
import csv
CSV_PATH = "homework.csv"

def load_homework():
    try: #must exist or will crash
        with open(CSV_PATH, newline="", encoding="utf-8") as tasks_file:
            temp = []
            for row in csv.DictReader(tasks_file):
                temp.append({
                    "id": int(row["id"]),
                    "subject": row["subject"],
                    "due_date": row["due_date"],
                    "status": row["status"]
                })
            return temp

            # return [{"task id":int(r["id"]), "subject": r["subject"]} for r in csv.DictReader(f)] #for loop (irrelevant rn)

    except FileNotFoundError: #if doesn't exist, this recovers the program rather than crashing
        with open(CSV_PATH, "w", newline="", encoding="utf-8") as f: #w is important as it WRITES
            w = csv.DictWriter(f, fieldnames=["id", "subject", "due_date", "status"])
            w.writeheader()
            return[] #returns an empty list


def save_homework(tasks):
    with open(CSV_PATH, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=["id", "subject", "due_date", "status"])
        w.writeheader()
        for task in tasks:
            w.writerow({
                "id": task["id"],
                "subject": task["subject"],
                "due_date": task["due_date"],
                "status": task["status"]
            })

        #w.writerows([{"id": s["id"], "subject": s["subject"]} for s in homework]) #open flags
        #"r" (read), "a" (open, writing, end, -> append), "w" (open, truncates, starts, -> write)
#homework = load_homework()


def refresh_tree(tree, tasks):
    """Clears and repopulates the Treeview with tasks from the list."""
    for i in tree.get_children():
        tree.delete(i)
    #for s in tasks:
    #   tree.insert("", tk.END, values=(s["id"], s["subject"], s["due_date"], s["status"]))
    
    for index, s in enumerate(tasks):
        tag = "even" if index % 2 == 0 else "odd"
        tree.insert("", tk.END,
                values=(s["id"], s["subject"], s["due_date"], s["status"]),
                tags=(tag,))


def main():

    root = tk.Tk()
    style = ttk.Style()
    style.theme_use("clam")  # important for colouring ttk widgets
    root.title("Homework Tracker (Lesson 1)")
    root.geometry("950x450")
    root.rowconfigure(0, weight=1)
    root.columnconfigure(0, weight=1)
    
    style.configure("Custom.TFrame", background="#e3e8ef") #changes background colours
    style.configure("Custom.TLabel",
                background="#e3e8ef", #changes the label colours
                foreground="#222")

    frame = ttk.Frame(root, padding=12, style="Custom.TFrame")
    frame.grid(row=0, column=0, sticky="nsew")

    frame.columnconfigure(1, weight=1)
    frame.columnconfigure(3, weight=2)
    frame.rowconfigure(5, weight=1)


    # add vars
    task_id_var = tk.StringVar()
    subject_var = tk.StringVar()
    desc_var = tk.StringVar()
    due_date_var = tk.StringVar()
    status_var = tk.StringVar(value="Pending") #string

    tasks = [] # The list to store task dictionaries


    ttk.Label(frame, text="Task ID", style="Custom.TLabel").grid(row=0, column=0, sticky="w", pady=6)
    ttk.Label(frame, text="Subject", style="Custom.TLabel").grid(row=1, column=0, sticky="w", pady=6)
    ttk.Label(frame, text="Description", style="Custom.TLabel").grid(row=2, column=0, sticky="w", pady=6)
    ttk.Label(frame, text="Due date (YYYY-MM-DD)", style="Custom.TLabel").grid(row=3, column=0, sticky="w", pady=6)
    ttk.Label(frame, text="Status", style="Custom.TLabel").grid(row=4, column=0, sticky="w", pady=6)


    entry_task_id = ttk.Entry(frame, textvariable=task_id_var)
    entry_task_id.grid(row=0, column=1, sticky="ew", pady=6)

    entry_subject = ttk.Entry(frame, textvariable=subject_var)
    entry_subject.grid(row=1, column=1, sticky="ew", pady=6)

    entry_desc = ttk.Entry(frame, textvariable=desc_var)
    entry_desc.grid(row=2, column=1, sticky="ew", pady=6)

    entry_due = ttk.Entry(frame, textvariable=due_date_var)
    entry_due.grid(row=3, column=1, sticky="ew", pady=6)

    combo_status = ttk.Combobox(frame, textvariable=status_var, values=["Pending", "Done"], state="readonly")
    combo_status.grid(row=4, column=1, sticky="ew", pady=6)

    # Define treeview columns using simple identifiers
    tree = ttk.Treeview(frame, columns=("id", "subject", "due", "status"), show="headings", height=12)
    tree.heading("id", text="Task ID")
    tree.heading("subject", text="Subject")
    tree.heading("due", text="Due Date")
    tree.heading("status", text="Status")
    tree.grid(row=0, column=3, rowspan=6, sticky="nsew", padx=(12, 0))

    #colour!
    style.configure("Treeview",
                background="white",
                foreground="black",
                fieldbackground="white", #makes rows white
                rowheight=25)

    style.map("Treeview",
            background=[("selected", "#4f8cff")]) #makes selected row blue

    style.configure("Treeview.Heading",
                background="#2c3e50", #makes headers navy
                foreground="white",
                font=("Segoe UI", 10, "bold"))
    #alternative row colours
    tree.tag_configure("odd", background="#eef2f7")
    tree.tag_configure("even", background="white")

    def on_select(_=None):
        seleted_row = tree.selection()
        if not seleted_row:
            return
        selected_task = tree.item(seleted_row[0], "values")
        task_id_var.set(selected_task[0]) 
        subject_var.set(selected_task[1])
        # desc_var.set(selected_task[?]) n/a
        due_date_var.set(selected_task[2])
        status_var.set(selected_task[3])
    
    tree.bind("<<TreeviewSelect>>", on_select)

    #----------------------------------
    
    def add_task():
        # Validate data
        task_id = task_id_var.get().strip()
        subject = subject_var.get().strip()
        due_date_str = due_date_var.get().strip()
        
        if not task_id.isdigit():
            messagebox.showerror("Invalid ID", "ID must be a whole number")
            return
        if not subject:
            messagebox.showerror("Invalid Subject", "Subject required")
            return
        
        try:
            # Attempt to make the date string into a datetime object for validation
            datetime.datetime.strptime(due_date_str, '%Y-%m-%d')
        except ValueError:
            # If this fails, display an error message
            messagebox.showerror("Invalid date format", "Use YYYY-MM-DD")
            return
        
        # Add to list (remove the redundant tree.insert call from the original code)
        tasks.append({
            'id': task_id,
            'subject': subject,
            'desc': desc_var.get().strip(),
            'due_date': due_date_str,
            'status': status_var.get().strip(),
        })

        # IMPORTANT TO LOAD
        refresh_tree(tree, tasks)
        
        # Clear the form fields
        # #clear_form(task_id_var, subject_var, desc_var, due_date_var, status_var)
        task_id_var.set('')
        subject_var.set('')
        desc_var.set('')
        due_date_var.set('')
        status_var.set(value="Pending")
        entry_task_id.focus_set()
    



    btn_add = ttk.Button(frame, text="Add task", command=add_task)
    btn_add.grid(row=5, column=1, sticky="ew", pady=(5, 0))
    btn_save = ttk.Button(frame, text="Save", command=lambda: save_homework(tasks))
    btn_save.grid(row=5, column=0, sticky="ew", pady=(5, 0))


    tasks = load_homework()
    refresh_tree(tree, tasks)
    entry_task_id.focus_set()
    #save_homework(homework)
    root.mainloop()



if __name__ == "__main__":
    main()

