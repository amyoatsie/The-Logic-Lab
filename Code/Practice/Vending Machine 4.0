#vending machine
itemA = float(1.20)
itemB = float(0.60)
itemC = float(0.75)
paid = 0

while True:
    chosen = str(input("Which item would you like? A, B, or C? ")).upper()   
    if chosen != "A" and chosen != "B" and chosen != "C": #checks whether they've chosen a valid item
        print("Item selected is not an option. Try again. ")
    else:
        break

coinValue = [200, 100, 50, 20, 10, 5] #redundant but here as a reference?
coinAmount = [3, 1, 5, 4, 2, 7]

def coins(paid, price):
    moneyLeft = int(round((paid - price) * 100))
    coin2 = 0; coin1 = 0; coin50 = 0; coin20 = 0; coin10 = 0; coin05 = 0 #defines number of coins used
    
    while True:
        if paid < price:
            print("Insufficient payment.")
            break
        elif moneyLeft >= 200 and coinAmount[0] > 0:
            moneyLeft -= 200
            coin2 = coin2 + 1
            coinAmount[0] = coinAmount[0] - 1
        elif moneyLeft >= 100 and coinAmount[1] > 0:
            moneyLeft -= 100
            coin1 = coin1 + 1
            coinAmount[1] = coinAmount[1] - 1
        elif moneyLeft >= 50 and coinAmount[2] > 0:
            moneyLeft -= 50
            coin50 = coin50 + 1
            coinAmount[2] = coinAmount[2] - 1
        elif moneyLeft >= 20 and coinAmount[3] > 0:
            moneyLeft -= 20
            coin20 = coin20 + 1
            coinAmount[3] = coinAmount[3] - 1
        elif moneyLeft >= 10 and coinAmount[4] > 0:
            moneyLeft -= 10
            coin10 = coin10 + 1
            coinAmount[4] = coinAmount[4] - 1
        elif moneyLeft >= 5 and coinAmount[5] > 0:
            moneyLeft -= 5
            coin05 = coin05 + 1
            coinAmount[5] = coinAmount[5] - 1
        else:
            remainder = moneyLeft
            break
    print("Your change is $"+ str((paid - price)) + " which will be paid by: \n$2 x " + str(coin2) + "\n$1 x " + str(coin1) + "\n$0.50 x " + str(coin50) +
          "\n$0.20 x " + str(coin20) + "\n$0.10 x " + str(coin10) + "\n$0.05 x " + str(coin05))
    if remainder != 0:
        print("Because of the limited number of coins available, you are still owed $" + str(remainder/100))

if chosen == "A":
    paid = float(input("Amount paid: $"))
    paidINT = int(round(paid * 100))
    while paidINT % 5 != 0:
        print("Error. Non-real input, please try again.")
        paid = float(input("Amount paid: $"))
        paidINT = int(round(paid * 100))
    coins(paid, itemA)

elif chosen == "B":
    paid = float(input("Amount paid: $"))
    paidINT = int(round(paid * 100))
    while paidINT % 5 != 0:
        print("Error. Non-real input, please try again.")
        paid = float(input("Amount paid: $"))
        paidINT = int(round(paid * 100))    
    coins(paid, itemB)

elif chosen == "C":
    paid = float(input("Amount paid: $"))
    paidINT = int(round(paid * 100))
    while paidINT % 5 != 0:
        print("Error. Non-real input, please try again.")
        paid = float(input("Amount paid: $"))
        paidINT = int(round(paid * 100))
    coins(paid, itemC)
