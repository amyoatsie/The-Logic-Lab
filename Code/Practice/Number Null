
numNumbers = 0
sumNumbers = 0

while True:
    currentNum = input("Enter a number: ")
    if currentNum =='':
        break
    else:
        numNumbers += 1
        sumNumbers = sumNumbers + int(currentNum)

print("You entered " + str(numNumbers) + " numbers.")
print("The sum of the numbers entered is " + str(sumNumbers) + ".")
if sumNumbers != 0:
    print("The mean of the numbers entered is " + str(round((numNumbers / sumNumbers), 4)) + ".")
else:
    print("The mean of your numbers is undefined.")
