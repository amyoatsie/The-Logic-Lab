import tkinter as tk

root = tk.Tk()

root.title("My First App")

root.geometry("300x200")

label = tk.Label(root, text = "Hello, Tkinter!")
label.place(x = 110, y = 40)

button = tk.Button(root, text = "Click Me", command = lambda: label.config(text="You Clicked the button!"))
button.place(x=110, y=80)

check = tk.Checkbutton(root, text = "Unclick?", command = lambda: label.config(text="You Unclicked the button!"))
check.place(x=110, y = 150)

root.mainloop()