BEGIN
// perform a linear search
    INPUT search_item
    INPUT item_list
    found ← FALSE

    FOR i ← 0 TO LENGTH(item_list) - 1 DO
        IF item_list[i] = search_item THEN
            found ← TRUE
            PRINT "Item found at position" + i
            BREAK
        ENDIF
    ENDFOR
    
    IF found = FALSE THEN
        PRINT "Item not found"
    ENDIF
END