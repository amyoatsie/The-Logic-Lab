~ WITH function
FUNCTION Calculate_Score(userAnswers, correctAnswers)
    score ← 0

    FOR i ← 0 TO LENGTH(correctAnswers) - 1 DO
        IF userAnswers[i] = correctAnswers[i] THEN
            score ← score + 1
        ENDIF
    ENDFOR
    RETURN score
END FUNCTION

BEGIN
//Submit challenge
    INPUT userAnswers
    INPUT correctAnswers

    score ← CALL Calculate_Score WITH userAnswers, correctAnswers
    OUTPUT score
END
