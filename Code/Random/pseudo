BEGIN FUNCTION Unlock_Challenge(score)
    IF score >= PASS_MARK THEN
        RETURN TRUE
    ELSE
        RETURN FALSE
    ENDIF
END FUNCTION
~
BEGIN
    INPUT score

    challengeUnlocked ← CALL Unlock_Challenge WITH score
    OUTPUT challengeUnlocked
END
~
BEGIN MODULE User.login(username)
    IF username = "" THEN
        OUTPUT "Please enter a username"
        RETURN FALSE
    ELSE
        // Retrieve progress from data store
        RETURN TRUE
    ENDIF
END MODULE

BEGIN MODULE User.resetProgress()
    numCompleted ← 0
    currentChallenge ← 1
    OUTPUT "Progress reset to 0%"
    RETURN TRUE
END MODULE
~
BEGIN MODULE Challenge.loadChallenge(challengeID)
    // Simulates checking if the challenge is unlocked in the CSV file
    IF challengeID ≤ numCompleted + 1 THEN
        OUTPUT "Challenge Screen Loaded"
        RETURN TRUE
    ELSE
        OUTPUT "This challenge is locked"
        RETURN FALSE
    ENDIF
END MODULE
